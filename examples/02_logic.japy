# JapyScript logic demo
var i = 0
var total = 0
var speed = -3

while (i < 5) {
    i = i + 1
    if (i % 2 == 0) {
        total = total + i
    } else if (i == 5) {
        print("five!")
    } else {
        print("odd number: " + i)
    }
}

print("total: " + total)
print("speed * -2 + 10 / 4 = " + (speed * -2 + 10 / 4))
print(5 > 3 && 2 >= 2)
print(!(1 == 2))
